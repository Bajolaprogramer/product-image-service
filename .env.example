# Copy to `.env` and adjust as needed. All values are optional and fall back
# to the defaults defined in app/core/config.py.

# --- Service metadata ---
SERVICE_NAME=product-image-service
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false

# --- HTTP / server ---
HOST=0.0.0.0
PORT=8000

# --- External image provider (reserved for future use) ---
EXTERNAL_API_BASE_URL=
EXTERNAL_API_KEY=
EXTERNAL_API_TIMEOUT_SECONDS=10.0
