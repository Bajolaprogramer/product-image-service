# Copy to `.env` and adjust as needed. All values are optional and fall back
# to the defaults defined in app/core/config.py.

# --- Service metadata ---
SERVICE_NAME=product-image-service
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false

# --- HTTP / server ---
HOST=0.0.0.0
PORT=8000

# --- External image providers ---
EXTERNAL_API_KEY=
EXTERNAL_API_TIMEOUT_SECONDS=10.0

# Open Food Facts public API root.
OPEN_FOOD_FACTS_BASE_URL=https://world.openfoodfacts.org

# --- Resilience (circuit breaker) ---
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT_SECONDS=30.0
