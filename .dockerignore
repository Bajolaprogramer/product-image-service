# Version control
.git
.gitignore

# Python caches / artifacts (recursive — Docker matches full relative paths)
**/__pycache__/
**/*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment files (provide config at runtime, not in the image)
.env
.env.*
!.env.example

# Tests and local-only files (not needed in the runtime image)
tests/

# Editor / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Docs / compose (not needed inside the image)
README.md
docker-compose.yml
